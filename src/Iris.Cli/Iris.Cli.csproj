<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>iris</AssemblyName>
    <RootNamespace>Iris.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iris</ToolCommandName>
    <PackageId>iris-agent</PackageId>
    <Authors>Onyx</Authors>
    <Description>Iris, a terminal coding agent with read, bash, edit and write tools, fullscreen TUI and C# extensions.</Description>
    <PackageTags>ai;agent;coding-agent;cli;tui;llm</PackageTags>
    <PackageProjectUrl>https://github.com/OnyxGH/Iris</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OnyxGH/Iris.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- One small package per platform instead of every native library in one package (.NET 10 RID-specific tools). -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Native debug symbols from dependencies (e.g. libSkiaSharp.pdb, ~100 MB per Windows architecture) are not shipped. -->
  <Target Name="RemoveNativeDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And '%(ResolvedFileToPublish.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Ships the full license text, including the notice of the project Iris is derived from. -->
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.CodingAgent\Iris.CodingAgent.csproj" />
  </ItemGroup>

</Project>
